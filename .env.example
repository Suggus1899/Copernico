# Plantilla de variables de entorno de la API. Copiar a .env (nunca subir .env a git).

NODE_ENV=development
PORT=4002

# MongoDB. Las transacciones de citas exigen replica set: en local usa rs0
# (docker compose lo inicializa solo). En Atlas usa la cadena de conexión del cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/copernico?replicaSet=rs0

# Sesión: JWT firmado dentro de una cookie HttpOnly. En producción, mínimo 32 caracteres.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Orígenes permitidos (CORS y comprobación de Origin en métodos que cambian datos), separados por comas.
FRONTEND_URL=http://localhost:5173

# Proxies de confianza delante de la API. En Render usar 1 (IP real del cliente y cookies Secure).
TRUST_PROXY=0

# Documentos y avatares: "local" (solo desarrollo) o "supabase" (producción, bucket privado).
STORAGE_DRIVER=local
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=copernico-private
