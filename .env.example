# Plantilla de variables de entorno de la API. Copiar a .env (nunca subir .env a git).

NODE_ENV=development
PORT=4002

# MongoDB. Las transacciones de citas exigen replica set: en local usa rs0
# (docker compose lo inicializa solo). En Atlas usa la cadena de conexión del cluster.
MONGODB_URI=mongodb://127.0.0.1:27017/copernico?replicaSet=rs0

# Sesión: JWT firmado dentro de una cookie HttpOnly. En producción, mínimo 32 caracteres.
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Orígenes permitidos (CORS y comprobación de Origin en métodos que cambian datos), separados por comas.
FRONTEND_URL=http://localhost:5173

# Proxies de confianza delante de la API (cuántos saltos añaden X-Forwarded-For). Local: 0.
# Producción con Vercel reescribiendo /api hacia Render: 2 (Vercel + balanceador de Render).
# Solo si el cliente llega directamente a Render: 1.
TRUST_PROXY=0

# Almacenamiento privado (avatares, documentos y materiales). Obligatorio en producción.
# Crear un bucket PRIVADO (no público) en Supabase. La service role key solo va en el backend.
# Sin estas variables, las subidas responden 503 STORAGE_NOT_CONFIGURED.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=copernico-private
