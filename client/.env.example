# Plantilla del cliente. Copiar a client/.env solo si hace falta cambiar algo.
# Por defecto el cliente llama a /api (mismo origen): en desarrollo lo reenvía Vite
# y en producción lo reescribe Vercel hacia la API en Render.

# Solo si la API vive en otro origen (no recomendado: las cookies de sesión son de mismo sitio).
# VITE_API_URL=/api

# Destino del proxy de Vite. Fuera de Docker: http://localhost:4002 (valor por defecto).
# API_PROXY_TARGET=http://localhost:4002
