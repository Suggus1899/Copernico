{
  "name": "copernico-api",
  "version": "1.0.0",
  "private": true,
  "description": "API de Copérnico Academy (Express + MongoDB)",
  "type": "module",
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/src/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "node --import=tsx --test --test-concurrency=2 --test-reporter=spec \"test/**/*.test.*\"",
    "seed:demo": "tsx scripts/seed_demo.ts",
    "test:compiled": "node --import=tsx --test --test-reporter=spec test/compiled.smoke.ts",
    "migrate:advisors": "node dist/scripts/migrate_advisors_to_tutors.js",
    "migrate:courses": "node dist/scripts/create_courses_from_appointments.js",
    "typecheck": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "db:init": "tsx scripts/init-replica-set.ts"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.8",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
